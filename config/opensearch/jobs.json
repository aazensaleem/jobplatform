{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "long" },
      "title": { "type": "text" },
      "description": { "type": "text" },
      "company_name": { "type": "text" },
      "location": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "job_type": { "type": "keyword" },
      "experience_level": { "type": "keyword" },
      "skills": { "type": "text" },
      "status": { "type": "keyword" }
    }
  }
}
