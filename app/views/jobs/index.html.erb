<h1>Jobs</h1>

<p>
  <% if can?(:create, Job.new) %>
    <%= link_to "Post a job", new_job_path %> |
  <% end %>
  <%= link_to "View companies", companies_path %>
</p>

<%= form_with url: jobs_path, method: :get do |form| %>
  <fieldset>
    <legend>Filter jobs</legend>
    <p>Without keywords, filters match the full field value. Keyword searches show active jobs only.</p>
    <div class="filter-grid">
    <p>
      <%= form.label :q, "Keywords" %>
      <%= form.search_field :q, value: @filters["q"] %>
    </p>
    <p>
      <%= form.label :location %>
      <%= form.text_field :location, value: @filters["location"] %>
    </p>
    <p>
      <%= form.label :job_type, "Job type" %>
      <%= form.text_field :job_type, value: @filters["job_type"] %>
    </p>
    <p>
      <%= form.label :experience_level, "Experience level" %>
      <%= form.text_field :experience_level, value: @filters["experience_level"] %>
    </p>
    <p>
      <%= form.label :status %>
      <%= form.select :status, Job::STATUSES.map { |status| [status.humanize, status] },
                      { include_blank: "All statuses", selected: @filters["status"] } %>
    </p>
    <p>
      <%= form.label :company_id, "Company" %>
      <%= form.collection_select :company_id, @filter_companies, :id, :name,
                                 { include_blank: "All companies", selected: @filters["company_id"] } %>
    </p>
    </div>
    <% if current_user&.employer_approved? %>
      <p>
        <%= form.check_box :my_jobs, checked: @my_jobs, data: { submit_on_change: true } %>
        <%= form.label :my_jobs, "Show only my job listings" %>
      </p>
    <% end %>
    <div class="form-actions">
    <%= form.submit "Filter jobs", name: nil %>
    <%= link_to "Clear filters", jobs_path %>
    </div>
  </fieldset>
<% end %>

<% if @search_unavailable %>
  <p>Keyword search is unavailable. Start OpenSearch and run <code>bin/rails jobs:reindex</code>, then try again.</p>
<% elsif @jobs.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Company</th>
        <th>Location</th>
        <th>Job type</th>
        <th>Experience level</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @jobs.each do |job| %>
        <tr>
          <td><%= link_to job.title, job %></td>
          <td><%= link_to job.company.name, job.company %></td>
          <td><%= job.location %></td>
          <td><%= job.job_type %></td>
          <td><%= job.experience_level %></td>
          <td><%= job.status.humanize %></td>
          <td>
            <%= link_to "View", job %>
            <% if can?(:update, job) %>
              <%= link_to "Edit", edit_job_path(job) %>
            <% end %>
            <% if can?(:destroy, job) %>
              <%= button_to "Delete", job, method: :delete,
                            data: { confirm: "Delete this job?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= @filters.any? ? "No jobs match your filters." : @my_jobs ? "You have not posted any jobs yet." : "No jobs have been posted yet." %></p>
<% end %>
