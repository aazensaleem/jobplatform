<h1>Admin · Companies</h1>
<%= render "admin/navigation" %>

<% if @companies.any? %>
  <table>
    <thead><tr><th>Company</th><th>Employer</th><th>Location</th><th>Actions</th></tr></thead>
    <tbody>
      <% @companies.each do |company| %>
        <tr>
          <td><%= link_to company.name, admin_company_path(company) %></td>
          <td><%= link_to company.user.email, admin_user_path(company.user) %></td>
          <td><%= company.location.presence || "Not specified" %></td>
          <td>
            <%= link_to "View jobs", admin_company_path(company) %>
            <%= button_to "Delete company", admin_company_path(company), method: :delete,
                          data: { confirm: "Delete this company and all its jobs and applications?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No companies yet.</p>
<% end %>
