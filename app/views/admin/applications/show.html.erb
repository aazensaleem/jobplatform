<h1>Application for <%= @application.job.title %></h1>
<%= render "admin/navigation" %>

<dl>
  <dt>Candidate</dt><dd><%= link_to @application.user.email, admin_user_path(@application.user) %></dd>
  <dt>Job</dt><dd><%= link_to @application.job.title, job_path(@application.job) %></dd>
  <dt>Company</dt><dd><%= link_to @application.job.company.name, admin_company_path(@application.job.company) %></dd>
  <dt>Status</dt><dd><%= @application.status.humanize %></dd>
  <dt>Applied</dt><dd><%= @application.created_at.to_fs(:long) %></dd>
  <dt>Cover letter</dt><dd><%= simple_format(@application.cover_letter.presence || "No cover letter provided.") %></dd>
</dl>
<p><%= link_to "Back to applications", admin_applications_path %></p>
