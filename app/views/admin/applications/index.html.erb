<h1>Admin · Applications</h1>
<%= render "admin/navigation" %>

<%= grid(@applications_grid, show_filters: :always, hide_submit_button: true, hide_reset_button: true) do |g| %>
  <% g.column(name: "Candidate", attribute: "email", assoc: :user) { |application| link_to(application.user.email, admin_user_path(application.user)) } %>
  <% g.column(name: "Job", attribute: "title", assoc: :job) { |application| link_to(application.job.title, admin_application_path(application)) } %>
  <% g.column(name: "Company", attribute: "name", assoc: [ :job, :company ]) { |application| link_to(application.job.company.name, admin_company_path(application.job.company)) } %>
  <% g.column(name: "Status", attribute: "status", custom_filter: Application::STATUSES.map { |status| [status.humanize, status] }) { |application| application.status.humanize } %>
  <% g.column(name: "Applied", attribute: "created_at") { |application| application.created_at.to_fs(:long) } %>
<% end %>
<div class="admin-grid-actions"><button type="button" class="admin-grid-apply">Apply filters</button><%= link_to "Clear filters", admin_applications_path %></div>
