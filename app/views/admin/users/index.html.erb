<h1>Admin · Users</h1>
<%= render "admin/navigation" %>
<p><%= link_to "Pending employer requests (#{@pending_employers_count})", admin_users_path(role: "employer", approval_status: "pending") %></p>

<%= grid(@users_grid, show_filters: :always, hide_submit_button: true, hide_reset_button: true) do |g| %>
  <% g.column(name: "Email", attribute: "email") { |user| link_to(user.email, admin_user_path(user)) } %>
  <% g.column(name: "Role", attribute: "role", custom_filter: User::ROLES.map { |role| [role.humanize, role] }) { |user| user.role.humanize } %>
  <% g.column(name: "Employer approval", attribute: "employer_approval_status",
              custom_filter: User::EMPLOYER_APPROVAL_STATUSES.map { |status| [status.humanize, status] }) do |user|
       user.employer? ? user.employer_approval_status.humanize : "—"
     end %>
  <% g.column(name: "Joined", attribute: "created_at") { |user| user.created_at.to_fs(:long) } %>
  <% g.column(name: "Actions") { |user| link_to("Inspect", admin_user_path(user)) } %>
<% end %>
<div class="admin-grid-actions"><button type="button" class="admin-grid-apply">Apply filters</button><%= link_to "Clear filters", admin_users_path %></div>
<% if @users_grid.current_page_records.empty? %><p>No users match these filters.</p><% end %>
